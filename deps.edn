{:aliases
   {; `dev` aliases include code in `dev/` that can be evaluated (or
    ; immediately run like `user/reload`)
    :dev {:extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.0"}}
          :extra-paths ["dev"]}
    :splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.24.0"}}
             :main-opts ["-m" "noahtheduke.splint"]}
    :test {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                        org.clojure/test.check {:mvn/version "1.1.1"}}
           :extra-paths ["test"]
           :main-opts ["-m" "kaocha.runner"]}
    :test-watch {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                              org.clojure/test.check {:mvn/version "1.1.1"}}
                 :extra-paths ["test"]
                 :main-opts ["-m" "kaocha.runner" "--watch"]}}
 :deps {babashka/fs {:mvn/version "0.5.25"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1368"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1093"}
        com.zaxxer/HikariCP {:mvn/version "7.0.2"}
        dev.weavejester/hashp {:mvn/version "0.5.1"}
        io.pedestal/pedestal.http-kit {:mvn/version "0.8.1"}
        org.clojure/clojure {:mvn/version "1.13.0-alpha3"}
        org.postgresql/postgresql {:mvn/version "42.7.11"}}
 :paths ["src"]}
